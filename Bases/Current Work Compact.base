filters:
  and:
    - file.name == "STATUS"
    - file.inFolder("Projects")
    - status != "done"
formulas:
  project: file.folder.replace(/^Projects\//, "").replace(/\/Active-Work.*$/, "")
properties:
  title:
    displayName: Task
  formula.project:
    displayName: Project
views:
  - type: table
    name: Compact
    groupBy:
      property: status
      direction: ASC
    order:
      - title
      - file.tags
      - file.backlinks
    sort:
      - property: file.tags
        direction: DESC
      - property: title
        direction: ASC
  - type: list
    name: List
    groupBy:
      property: status
      direction: ASC
    order:
      - title
      - file.tags
    sort:
      - property: file.name
        direction: ASC
    cardSize: 140
    imageFit: contain
    markers: none
